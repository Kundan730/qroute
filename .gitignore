# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.prof

# Node
node_modules/
frontend/dist/
.vite/

# Data caches. The road graphs are ~40 MB and are regenerable: data/osm/networks.json
# records the exact OSMnx recipe and `qroute osm fetch` rebuilds all three from it.
data/cache/
data/osm/*.graphml
!data/osm/.gitkeep
!data/osm/networks.json
!data/osm/index.json

# Results. The raw per-run log of the definitive benchmark is 54 MB, so it is
# committed gzipped; everything a reader needs to check a number (the summary,
# the tables, the figures and the provenance) is committed uncompressed.
results/runs/**/rows.jsonl
*.log

# OS / editors
.DS_Store
qroute.egg-info/
cache/
.idea/
.vscode/
